{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(python -m http.server 8080)",
      "Bash(python validate.py)",
      "Bash(python update.py)",
      "Bash(python gen_dashboard.py)"
    ],
    "deny": [
      "Read(.env)",
      "Read(./.env)",
      "Read(**/.env)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)"
    ]
  }
}
